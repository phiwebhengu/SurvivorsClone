#root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

#background
{
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    background-color: rgba(0,0,0,0.45);
}

#menu-container
{
    width: 420px;

    padding-top: 32px;
    padding-bottom: 32px;
    padding-left: 42px;
    padding-right: 42px;

    background-color: rgb(18,20,45);

    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-right-width: 4px;

    border-top-color: rgb(229,194,78);
    border-bottom-color: rgb(229,194,78);
    border-left-color: rgb(229,194,78);
    border-right-color: rgb(229,194,78);

    flex-direction: column;
    align-items: center;
}

#title
{
    font-size: 42px;

    -unity-font-style: bold;

    color: rgb(255,223,95);

    margin-bottom: 12px;

    letter-spacing: 2px;

    -unity-text-align: middle-center;
}

#subtitle
{
    color: rgb(225,225,225);

    font-size: 18px;

    margin-bottom: 30px;

    -unity-text-align: middle-center;
}

Button
{
    width: 260px;
    height: 56px;

    margin-bottom: 15px;

    font-size: 22px;

    -unity-font-style: bold;

    background-color: rgb(42,93,214);

    color: white;

    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-right-width: 3px;

    border-top-color: rgb(120,180,255);
    border-left-color: rgb(120,180,255);

    border-right-color: rgb(18,46,120);
    border-bottom-color: rgb(18,46,120);
}

Button:hover
{
    background-color: rgb(63,118,235);
}

Button:active
{
    background-color: rgb(25,70,175);
}

#version {
    margin-top: 20px;
    color: rgb(140, 140, 140);
    font-size: 13px;
}

.hidden {
    display: none;
}

#home-panel,
#settings-panel,
#upgrades-panel,
#credits-panel {
    width: 450px;
    padding: 35px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 12px;
    align-items: center;
    color: rgb(255, 255, 255);
}

.panel-title {
    font-size: 36px;
    unity-font-style: bold;
    color: white;
    margin-bottom: 25px;
}

ScrollView {
    width: 100%;
    height: 300px;
    margin-bottom: 20px;
}

.upgrade-card {
    padding: 12px;
    margin-bottom: 12px;
    background-color: rgb(45, 45, 45);
    border-radius: 8px;
}

.upgrade-name {
    font-size: 18px;
    unity-font-style: bold;
    color: white;
    margin-bottom: 5px;
}
