#root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

#background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(18, 18, 18);
}

#menu-container {
    width: 420px;
    align-items: center;
    padding-top: 50px;
    padding-bottom: 50px;
    padding-left: 40px;
    padding-right: 40px;
    background-color: rgba(0, 0, 0, 0.45);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

#title {
    font-size: 48px;
    unity-font-style: bold;
    color: white;
    margin-bottom: 8px;
}

#subtitle {
    font-size: 18px;
    color: rgb(190, 190, 190);
    margin-bottom: 35px;
}

Button {
    width: 280px;
    height: 48px;
    margin-bottom: 12px;
    font-size: 18px;
    color: white;
    background-color: rgb(60, 60, 60);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

Button:hover {
    background-color: rgb(95, 95, 95);
}

Button:active {
    background-color: rgb(120, 120, 120);
}

#version {
    margin-top: 20px;
    color: rgb(140, 140, 140);
    font-size: 13px;
}

.hidden {
    display: none;
}

#home-panel,
#settings-panel,
#upgrades-panel,
#credits-panel {
    width: 450px;
    padding: 35px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 12px;
    align-items: center;
    color: rgb(255, 255, 255);
}

.panel-title {
    font-size: 36px;
    unity-font-style: bold;
    color: white;
    margin-bottom: 25px;
}

ScrollView {
    width: 100%;
    height: 300px;
    margin-bottom: 20px;
}

.upgrade-card {
    padding: 12px;
    margin-bottom: 12px;
    background-color: rgb(45, 45, 45);
    border-radius: 8px;
}

.upgrade-name {
    font-size: 18px;
    unity-font-style: bold;
    color: white;
    margin-bottom: 5px;
}
