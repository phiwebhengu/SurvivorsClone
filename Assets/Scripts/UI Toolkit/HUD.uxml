<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/UI%20Toolkit/HUD.uss?fileID=7433441132597879392&amp;guid=0554f718daeea754f9ff5a9b29bf714a&amp;type=3#HUD"/>
    <ui:VisualElement name="root">
        <ui:VisualElement name="top-container">
            <ui:ProgressBar name="xp-bar" title="" style="-unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgb(0, 0, 0);"/>
            <ui:Label name="level-label" text="Lv. 1" style="top: 0; left: 1756px; color: rgb(0, 0, 0); letter-spacing: 1px; -unity-font-style: bold;"/>
            <ui:Label name="timer-label" text="00:00"/>
        </ui:VisualElement>
        <ui:VisualElement xmlns:ui="UnityEngine.UIElements" name="victory-overlay" class="overlay hidden">
            <ui:VisualElement class="panel">
                <ui:Label name="title" text="STAGE COMPLETED" class="title"/>
                <ui:VisualElement class="divider"/>
                <ui:VisualElement class="stats">
                    <ui:VisualElement class="stat-row">
                        <ui:Label text="Survived Time"/>
                        <ui:Label name="time-value" text="10:00"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="stat-row">
                        <ui:Label text="Level Reached"/>
                        <ui:Label name="level-value" text="15"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="stat-row">
                        <ui:Label text="Enemies Defeated"/>
                        <ui:Label name="kills-value" text="327"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="stat-row">
                        <ui:Label text="Experience Collected"/>
                        <ui:Label name="xp-value" text="2387"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="button-row">
                    <ui:Button name="restart-button" text="Play Again"/>
                    <ui:Button name="quit-button" text="Quit"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
