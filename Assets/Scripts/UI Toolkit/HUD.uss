#root {
    flex-grow: 1;
}

#top-container {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 18px;
    height: 28px;
    align-items: center;
}

#xp-bar {
    position: absolute;
    left: 0;
    right: 90px;
    height: 18px;
}

.unity-progress-bar__background {
    background-color: rgb(35, 35, 35);
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
}

.unity-progress-bar__progress {
    background-color: rgb(45, 150, 255);
}

#level-label {
    position: absolute;
    left: 90%;
    translate: -50% 0;
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
    font-size: 14px;
    -unity-text-align: middle-center;
}

#timer-label {
    position: absolute;
    right: 0;
    width: 70px;
    color: white;
    font-size: 16px;
    -unity-text-align: middle-center;
}


.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    justify-content: center;
    align-items: center;

    background-color: rgba(0, 0, 0, 0.70);
}

.hidden {
    display: none;
}

.panel {
    width: 560px;

    padding-top: 32px;
    padding-bottom: 32px;
    padding-left: 42px;
    padding-right: 42px;

    background-color: rgb(18, 20, 45);

    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-right-width: 4px;

    border-top-color: rgb(229, 194, 78);
    border-bottom-color: rgb(229, 194, 78);
    border-left-color: rgb(229, 194, 78);
    border-right-color: rgb(229, 194, 78);

    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.title {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(255, 223, 95);

    margin-bottom: 18px;

    letter-spacing: 2px;

    -unity-text-align: middle-center;
}

.divider {
    width: 100%;
    height: 3px;

    margin-bottom: 28px;

    background-color: rgb(229, 194, 78);
}

.stats {
    width: 100%;
    margin-bottom: 30px;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 14px;

    font-size: 22px;

    color: rgb(245,245,245);
}

.button-row {
    flex-direction: row;
    justify-content: center;

    gap: 24px;

    width: 100%;
    margin-top: 8px;
}

Button {
    width: 200px;
    height: 58px;

    font-size: 22px;
    -unity-font-style: bold;

    color: white;

    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-right-width: 3px;
}

#retry-button {

    background-color: rgb(42, 93, 214);

    border-top-color: rgb(120,180,255);
    border-left-color: rgb(120,180,255);

    border-right-color: rgb(18,46,120);
    border-bottom-color: rgb(18,46,120);
}

#retry-button:hover {
    background-color: rgb(63,118,235);
}

#retry-button:active {
    background-color: rgb(25,70,175);
}


#menu-button {

    background-color: rgb(205,163,55);

    border-top-color: rgb(255,225,120);
    border-left-color: rgb(255,225,120);

    border-right-color: rgb(125,92,20);
    border-bottom-color: rgb(125,92,20);

    color: rgb(35,35,35);
}

#menu-button:hover {
    background-color: rgb(225,181,60);
}

#menu-button:active {
    background-color: rgb(170,130,35);
}